# Postgres connection string.
# Local Docker (see docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skill_marketplace"
# Existing deployments may use another Postgres provider. Preview uses the
# Supabase connection below for accounts, catalog, reviews, and private recipes.

# Better Auth
BETTER_AUTH_SECRET="dev-secret-change-me-in-production-please-32chars"
BETTER_AUTH_URL="http://localhost:3000"

# Anthropic (LLM injection classifier). Optional in dev — the scanner's LLM
# layer is best-effort and degrades gracefully when this is unset.
ANTHROPIC_API_KEY=""

# Public-facing private contact for the beta policy pages; set only an owner-approved inbox.
# PRIVACY_CONTACT_EMAIL=support@example.com

# SEO launch settings. Leave indexing disabled on local/Preview deployments.
# Production only: set to the final verified HTTPS site origin, without a path.
# NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example
SEO_INDEXING_ENABLED=false
# Ownership verification tokens, supplied by the operator's Search Console/Bing account.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Owner/team recipe package inspection; integer from 1 to 60.
RECIPE_VALIDATIONS_PER_MINUTE=6

# Unified server-only Supabase Postgres connection, provisioned for Preview.
# When set outside Production, this takes precedence over DATABASE_URL.
# RECIPE_DEV_POSTGRES_URL=
